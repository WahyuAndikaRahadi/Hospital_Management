<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Pasien</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>
<body>
    <%- include('../partials/navbar') %>

    <div class="container mt-4">
        <h2>Edit Pasien</h2>
        <form action="/pasien/update/<%= pasien.no_rm %>" method="POST">
            <div class="mb-3">
                <label class="form-label">No RM:</label>
                <input type="text" name="no_rm" class="form-control" value="<%= pasien.no_rm %>" required readonly>
            </div>

            <div class="mb-3">
                <label class="form-label">KTP:</label>
                <input type="number" name="ktp" class="form-control" value="<%= pasien.ktp %>" required>
            </div>

            <div class="mb-3">
                <label class="form-label">Nama Pasien:</label>
                <input type="text" name="nama_pasien" class="form-control" value="<%= pasien.nama_pasien %>" required>
            </div>

            <div class="mb-3">
                <label class="form-label">Tanggal Lahir:</label>
                <input type="date" name="tgl_lahir" class="form-control" value="<%= pasien.tgl_lahir %>" required>
            </div>

            <div class="mb-3">
                <label class="form-label">Alamat:</label>
                <input type="text" name="alamat" class="form-control" value="<%= pasien.alamat %>" required>
            </div>

            <div class="mb-3">
                <label class="form-label">Tinggi (cm):</label>
                <input type="number" name="tinggi" class="form-control" value="<%= pasien.tinggi %>" required>
            </div>

            <div class="mb-3">
                <label class="form-label">Berat (kg):</label>
                <input type="number" name="berat" class="form-control" value="<%= pasien.berat %>" required>
            </div>

            <div class="mb-3">
                <label class="form-label">Ibu Kandung:</label>
                <input type="text" name="ibu_kandung" class="form-control" value="<%= pasien.ibu_kandung %>" required>
            </div>

            <button type="submit" class="btn btn-primary">Update</button>
            <a href="/pasien" class="btn btn-secondary">Batal</a>
        </form>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Daftar Pasien</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>
<body>
    <%- include('../partials/navbar') %>

    <div class="container mt-4">
        <h2 class="mb-3">Daftar Pasien</h2>
        <a href="/pasien/create" class="btn btn-success mb-3">Tambah Pasien</a>

        <table class="table table-bordered table-striped">
            <thead class="table-dark">
                <tr>
                    <th>No RM</th>
                    <th>Nama Pasien</th>
                    <th>Tanggal Lahir</th>
                    <th>Alamat</th>
                    <th>Tinggi</th>
                    <th>Berat</th>
                    <th>Ibu Kandung</th>
                    <th>Aksi</th>
                </tr>
            </thead>
            <tbody>
                <% pasien.forEach((p) => { %>
                    <tr>
                        <td><%= p.no_rm %></td>
                        <td><%= p.nama_pasien %></td>
                        <td><%= p.tgl_lahir %></td>
                        <td><%= p.alamat %></td>
                        <td><%= p.tinggi %></td>
                        <td><%= p.berat %></td>
                        <td><%= p.ibu_kandung %></td>
                        <td>
                            <a href="/pasien/edit/<%= p.no_rm %>" class="btn btn-warning btn-sm">Edit</a>
                            <a href="/pasien/delete/<%= p.no_rm %>" class="btn btn-danger btn-sm" onclick="return confirm('Yakin ingin menghapus?')">Hapus</a>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

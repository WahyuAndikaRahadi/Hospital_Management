<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tambah Reservasi</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>
<body>
    <%- include('../partials/navbar') %>

    <div class="container mt-4">
        <h2>Tambah Reservasi</h2>
        <form action="/reservasi/store" method="POST">
            <div class="mb-3">
                <label class="form-label">No RM:</label>
                <select name="no_rm" class="form-select" required>
                <% pasien.forEach((pasien) => { %>
                  <option value="<%= pasien.no_rm %>"><%= pasien.no_rm %></option>
              <% }) %>
              </select>
            </div>

            <div class="mb-3">
                <label class="form-label">Nama Poli:</label>
                <select name="id_poli" class="form-select" required>
                    <% poli.forEach((poli) => { %>
                        <option value="<%= poli.id_poli %>"><%= poli.nama_poli %></option>
                    <% }) %>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label">Nama Dokter:</label>
                <select name="id_dokter" class="form-select" required>
                    <% dokter.forEach((dokter) => { %>
                        <option value="<%= dokter.id_dokter %>"><%= dokter.nama_dokter %></option>
                    <% }) %>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label">No Antrian:</label>
                <select name="no_antrian" class="form-select" required>
                  <% antri.forEach((antri) => { %>
                      <option value="<%= antri.no_antrian %>"><%= antri.no_antrian %></option>
                  <% }) %>
              </select>
            </div>

            <button type="submit" class="btn btn-primary">Simpan</button>
            <a href="/reservasi" class="btn btn-secondary">Batal</a>
        </form>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
